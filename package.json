    "css-loader": "6.7.1",
    "dotenv": "14.3.2",
    "eslint": "8.21.0",
    "eslint-webpack-plugin": "3.2.0",
    "file-loader": "^6.2.0",
    "fs": "0.0.1-security",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.3.0",
    "jest-chrome": "0.7.2",
    "jest-environment-jsdom": "30.3.0",
    "npm-force-resolutions": "0.0.10",
    "patch-package": "8.0.0",
    "puppeteer-core": "^24.43.1",
    "react-hot-loader": "4.13.0",
    "redux-mock-store": "1.5.4",
    "sass-loader": "13.0.2",
    "sinon-chrome": "3.0.1",
    "style-loader": "3.3.1",
    "ts-jest": "29.4.6",
    "ts-loader": "9.3.1",
    "tsconfig-paths-webpack-plugin": "3.5.2",
    "typescript": "4.7.4",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "4.9.2",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "5.8.0"
  },
  "overrides": {
    "jest-chrome": {
      "jest": "$jest"
    },
    "sass-graph": {
      "scss-tokenizer": "$scss-tokenizer"
    },
    "ws": "^8.18.3",
    "hive-tx": "$hive-tx"
  },
  "browser": {
    "crypto": false
  },
  "workspaces": [
    "packages/*"
  ],
  "private": true
}
