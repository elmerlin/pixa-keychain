{
  "name": "pixtopia-keychain",
  "version": "0.1.0",
  "description": "Pixtopia Keychain: a wallet browser extension for the Pixagram blockchain",
  "main": "index.js",
  "directories": {
    "example": "example"
  },
  "scripts": {
    "dev": "npm outdated; concurrently \"npm:dev:*\"",
    "dev:chromium": "webpack --config webpack/chromium/webpack.dev.js -w",
    "dev:firefox": "webpack --config webpack/firefox/webpack.dev.js -w",
    "build": "npm outdated; concurrently \"npm:build:*\"",
    "build:chromium": "rm -rf ./dist-prod & webpack --config webpack/chromium/webpack.prod.js",
    "build:firefox": "rm -rf ./dist-prod-firefox & webpack --config webpack/firefox/webpack.prod.js",
    "analyze": "concurrently \"npm:analyze:*\"",
    "analyze:chromium": "npx webpack --profile --json > stats.json --config webpack/chromium/webpack.prod.js",
    "analyze:firefox": "npx webpack --profile --json > stats.json --config webpack/firefox/webpack.prod.js",
    "doc": "documentation build public/pixa_keychain.js -f md -c documentation/build/documentation.yml -o documentation/README.md",
    "test": "jest --verbose",
    "test:detect": "jest --verbose --detectOpenHandles",
    "test:watch": "jest --verbose --watch",
    "test:cov": "jest --verbose --coverage",
    "check-installed-libs": "node scripts/check-installed-libs.js",
    "git:archive": "rm -rf pixtopia-keychain*.zip; sh -c 'uploadStash=$(git stash create); git archive -o \"pixtopia-keychain-$(date +%Y%m%d-%H%M%S).zip\" ${uploadStash:-HEAD}'",
    "postinstall": "patch-package",
    "check:chain": "node scripts/check-serializer.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elmerlin/pixtopia-keychain.git"
  },
  "keywords": [
    "pixagram",
    "pixtopia",
    "keychain",
    "extension"
  ],
  "author": "elmerlin",
  "license": "MIT",
  "homepage": "https://pixtopia.net",
  "dependencies": {
    "@hiveio/hive-js": "2.0.8",
    "@hookform/resolvers": "3.1.1",
    "@types/chrome": "0.0.243",
    "@types/sanitize-html": "^2.13.0",
    "@types/yargs": "17.0.11",
    "axios": "1.13.6",
    "crypto-js": "4.2",
    "decimal.js": "10.4.3",
    "flatlist-react": "1.5.0",
    "hive-keychain-commons": "^1.13.3",
    "hive-tx": "file:vendor/hive-tx",
    "hotkeys-js": "^4.0.0",
    "joi": "17.13.3",
    "locate-path": "7.1.1",
    "lodash": "4.17.23",
    "moment": "2.29.4",
    "node-fetch": "3.2.10",
    "node-polyfill-webpack-plugin": "1.1.4",
    "react": "17.0.2",
    "react-beautiful-dnd": "13.1.1",
    "react-dom": "17.0.2",
    "react-dropdown-select": "4.9.0",
    "react-error-boundary": "4.0.11",
    "react-hook-form": "7.45.2",
    "react-redux": "7.2.8",
    "react-responsive-carousel": "3.2.23",
    "react-svg": "16.1.22",
    "react-tabs": "3.2.3",
    "react-toastify": "8.2.0",
    "redux": "4.2.1",
    "redux-thunk": "2.4.1",
    "resolve-cwd": "3.0.0",
    "sanitize-html": "^2.14.0",
    "sass": "1.65.1",
    "scss-tokenizer": "0.4.3",
    "url-loader": "4.1.1",
    "valid-url": "1.0.9"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.2",
    "@babel/eslint-parser": "^7.22.15",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@hiveio/dhive": "^1.2.7",
    "@hot-loader/react-dom": "17.0.2",
    "@svgr/webpack": "^8.0.1",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "12.1.5",
    "@testing-library/user-event": "14.4.3",
    "@types/chrome": "^0.0.243",
    "@types/crypto-js": "4.2",
    "@types/jest": "30.0.0",
    "@types/lodash.debounce": "^4.0.7",
    "@types/node": "17.0.45",
    "@types/react": "17.0.2",
    "@types/react-beautiful-dnd": "^13.1.4",
    "@types/react-dom": "17.0.2",
    "@types/react-tabs": "2.3.4",
    "@types/redux-mock-store": "1.0.3",
