{
  "name": "__MSG_keychain__",
  "description": "__MSG_description__",
  "default_locale": "en",
  "version": "0.1.3",
  "permissions": ["storage", "idle", "alarms"],
  "content_security_policy": "script-src 'self'; object-src 'self';",
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "/assets/images/icon-16.png",
      "32": "/assets/images/icon-32.png",
      "48": "/assets/images/icon-48.png",
      "128": "/assets/images/icon-128.png"
    }
  },
  "icons": {
    "16": "/assets/images/icon-16.png",
    "32": "/assets/images/icon-32.png",
    "48": "/assets/images/icon-48.png",
    "128": "/assets/images/icon-128.png"
  },
  "background": { "scripts": ["backgroundBundle.js"], "persistent": true },
  "web_accessible_resources": ["/assets/images/icon-16.png", "/assets/images/icon-32.png", "/assets/images/icon-48.png", "/assets/images/icon-128.png", "pixa_keychain.js"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["web_interfaceBundle.js"],
      "all_frames": true
    }
  ],
  "manifest_version": 2,
  "applications": {
    "gecko": { "id": "keychain@pixtopia.net" }
  }
}
