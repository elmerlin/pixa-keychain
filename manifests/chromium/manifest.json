{
  "name": "__MSG_keychain__",
  "description": "__MSG_description__",
  "default_locale": "en",
  "version": "0.1.3",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "idle", "alarms", "offscreen"],
  "host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "/assets/images/icon-16.png",
      "32": "/assets/images/icon-32.png",
      "48": "/assets/images/icon-48.png",
      "128": "/assets/images/icon-128.png"
    }
  },
  "icons": {
    "16": "/assets/images/icon-16.png",
    "32": "/assets/images/icon-32.png",
    "48": "/assets/images/icon-48.png",
    "128": "/assets/images/icon-128.png"
  },
  "background": { "service_worker": "backgroundBundle.js", "type": "module" },
  "web_accessible_resources": [
    {
      "resources": ["/assets/images/icon-16.png", "/assets/images/icon-32.png", "/assets/images/icon-48.png", "/assets/images/icon-128.png", "_locales/*"],
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "extension_ids": []
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["web_interfaceBundle.js"],
      "all_frames": true
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["pixa_keychain.js"],
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "manifest_version": 3
}
